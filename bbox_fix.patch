+def box_2d_to_dict(raw_box: Any) -> Optional[Dict[str, float]]:
+    """
+    Strictly converts Gemini's NATIVE detection format into our canonical dict.
+    Gemini returns box_2d as [ymin, xmin, ymax, xmax] on a 0-1000 grid (Y FIRST!).
+    No order guessing: guessing is what previously made boxes land on the wrong place.
+    """
+    if not isinstance(raw_box, (list, tuple)) or len(raw_box) != 4:
+        return None
+    try:
+        ymin, xmin, ymax, xmax = [float(v) for v in raw_box]
+    except (ValueError, TypeError):
+        return None
+    if any(v != v or abs(v) == float('inf') for v in (ymin, xmin, ymax, xmax)):
+        return None
+    return sanitize_box(xmin, ymin, xmax, ymax, min_size_px_in_1000=5.0)
+
